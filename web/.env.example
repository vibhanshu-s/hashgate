# Public: the deployed Hashgate contract and the block it was deployed in
NEXT_PUBLIC_HASHGATE_ADDRESS=0x...
NEXT_PUBLIC_DEPLOY_BLOCK=0
# Server only: a FRESH test wallet holding a little tQDAY (gas) and some tUSD8 (demo drips)
RELAYER_PRIVATE_KEY=0x...
# Optional: Gemini for invoice reading. Without it the agent uses a deterministic parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Client IP header used for rate limits (Vercel sets this and visitors can't fake it)
TRUSTED_IP_HEADER=x-vercel-forwarded-for
